{
  "name": "windwatcher-client",
  "version": "0.0.1-dev.0",
  "private": true,
  "description": "The shared web, desktop and Android client for Windwatcher.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "format": "bun --bun oxfmt .",
    "format:check": "bun --bun oxfmt --check .",
    "lint": "bun --bun oxlint",
    "lint:fix": "bun --bun oxlint --fix",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:e2e": "bun --bun playwright test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "tauri": "bun node_modules/@tauri-apps/cli/tauri.js"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
