{
  "name": "windwatcher-client",
  "version": "0.0.1-dev.0",
  "private": true,
  "description": "The shared web, desktop and Android client for Windwatcher.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "format": "bun --bun oxfmt .",
    "format:check": "bun --bun oxfmt --check .",
    "lint": "bun --bun oxlint",
    "lint:fix": "bun --bun oxlint --fix",
    "typecheck": "bun node_modules/typescript-checker/bin/tsc --noEmit",
    "api:generate": "bun scripts/api-generate.ts",
    "api:check": "bun scripts/api-generate.ts --check",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:e2e": "bun run build:network-test && bun run build:foundation-test && bun run build:shell-test && bun run build:local-discovery-test && bun --bun playwright test",
    "build:local-discovery-test": "bun scripts/build-local-discovery-test.ts",
    "build:shell-test": "bun scripts/build-shell-test.ts",
    "build:foundation-test": "bun scripts/build-foundation-test.ts",
    "build:network-test": "bun scripts/build-network-test.ts",
    "test:native:report": "bun scripts/check-native-report.ts",
    "check:target": "bun scripts/check-native-target.ts",
    "check": "bun run api:check && bun run check:target && bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "tauri": "bun node_modules/@tauri-apps/cli/tauri.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-http": "2.8.3",
    "i18next": "26.7.2",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-checker": "npm:typescript@7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@tauri-apps/plugin-http@2.8.3": "patches/@tauri-apps%2Fplugin-http@2.8.3.patch"
  }
}
