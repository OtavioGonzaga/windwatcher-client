{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "HTTP(S) to arbitrary user-directed servers; no filesystem or shell grants.",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*/*" }, { "url": "https://*:*/*" }]
    }
  ]
}
